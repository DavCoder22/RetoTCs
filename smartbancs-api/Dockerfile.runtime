# Imagen de RUNTIME del api: el JAR se construye FUERA del build de Docker
# (en el runner de CI, con caché de dependencias Maven), así el build de la
# imagen NO depende de descargar dependencias en la red del builder
# (evita los 403 intermitentes de Maven Central dentro de `docker build`).
# Uso (desde la raíz del repo):
#   mvn -B -ntp -pl smartbancs-api -am package -DskipTests
#   docker build -f smartbancs-api/Dockerfile.runtime -t smartbancs-api:latest .
FROM eclipse-temurin:21-jre
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY smartbancs-api/target/smartbancs-api-*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
