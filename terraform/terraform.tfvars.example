region             = "us-east-1"
profile            = ""
state_bucket       = "smartbancs-tfstate"
# openrouter_api_key se inyecta SOLO desde CI (secret OPENROUTER_API_KEY) o tu
# consola; nunca pongas el valor aquí (lo más seguro: dejarlo vacío).
openrouter_api_key = ""
# instancia elegible del Free Plan (post-jul-2025): t3.micro/t3.small/t4g.
# t3.medium NO se puede lanzar (error "not eligible for Free Tier").
# t3.small = 2 GB RAM (bootstrap crea swap automático solo si < 2 GB).
instance_type      = "t3.small"
image_tag          = "latest"
allowed_cidr       = "0.0.0.0/0"
# Volumen EBS dedicado a BBDD montado en /var/lib/docker (persiste ante replace).
postgres_volume_size_gb = 20
# ESTRATEGIA DE REDUNDANCIA (>=10.000 tx): ALB + 2ª EC2 api/ai con BBDD única.
#   true  => terraform apply crea el ALB y la 2ª instancia (cobra ~$18/mes ALB).
#   false => instancia única (estado actual de la demo).
redundancy_enabled = false