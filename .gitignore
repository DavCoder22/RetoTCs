# Maven build output (compiled artifacts must never be committed)
target/
*.class

# Maven release artifacts
release.properties
dependency-reduced-pom.xml
buildNumber.properties
pom.xml.next
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.tag

# IDEs and editors
.idea/
*.iml
*.ipr
*.iws
.settings/
.classpath
.project
.factorypath
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Demo evidence (generated by scripts/demo.sh)
scripts/evidencia/

# Environment and secrets (keep example files)
.env
.env.*
!.env.example
*.pem
*.key

# Node modules (future frontend / tooling)
node_modules/

# Personal / local tooling
.sonarlint/
.history/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example

# AWS local config (outside repo, but never tracked here)
.aws/

# ETL artifacts (generated outputs; raw sample data IS tracked)
etl/output/