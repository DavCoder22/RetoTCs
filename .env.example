# Copy to .env and adjust before running `docker compose up --build`.
POSTGRES_DB=smartbancs
POSTGRES_USER=smartbancs
POSTGRES_PASSWORD=change-me

# Observability stack (Grafana login)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# AI agent (Python/FastAPI + OpenRouter)
# Sin key el agente cae a un mock avanzado funcional (source=mock).
OPENROUTER_API_KEY=
AI_MODEL=moonshotai/kimi-k2.6

# Promtail monta el socket de Docker y el directorio de contenedores.
# Solo ajustar si Docker corre en modo rootless (verifica con `docker info | grep "Docker Root Dir"`):
# DOCKER_SOCKET=/run/user/1000/docker.sock
# DOCKER_CONTAINERS_DIR=$HOME/.local/share/docker/containers